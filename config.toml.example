# ============================================================================
# SECTION 1: CORE SERVER CONFIGURATION
# ============================================================================
# This section contains the fundamental server settings and memory management
# configuration that define how Aries operates.

[server]
host = "127.0.0.1"   # The host to listen on.
port = 3389          # The port to listen on.

# Plan mode configuration
# Aries operates exclusively in Plan mode, which decomposes complex user requests
# into structured subtasks with dependencies, then executes them in topological
# order using React loops for each subtask.
#
# Task Planning Configuration:
# max_plan_subtasks = 10           # Maximum number of subtasks in a plan (default: 10)
# plan_timeout_secs = 600          # Total timeout in seconds for plan execution (default: 600)
#
# Subtask Retry Configuration:
# subtask_max_retries = 2          # Maximum retries for failed subtasks (default: 2)
#                                  # Retryable errors: tool failures, timeouts, max iterations exceeded
#
# Subtask React Loop Configuration:
# subtask_react_max_iterations = 5 # Maximum React iterations per subtask (default: 5)
# subtask_react_timeout_secs = 60  # Timeout in seconds for each subtask (default: 60)
#
# Tool Call Configuration:
# max_tools_per_iteration = 5      # Maximum tool calls per iteration (default: 5)
# tool_call_max_retries = 2        # Maximum retries for failed tool calls (default: 2)
# tool_call_retry_delay_ms = 500   # Delay in milliseconds between retries (default: 500)

# Memory configuration
[memory]
enable = false                                    # Enable/disable memory functionality
database_path = "~/.aries/data/memory.db"                 # Path to SQLite database file or URL
                                                 # Examples:
                                                 #   - Simple path: "data/memory.db", "/tmp/app.db"
                                                 #   - SQLite URL: "sqlite:data/memory.db?mode=rwc"
                                                 #   - Memory DB: "sqlite::memory:" (temporary, lost on restart)
context_window = 8192                            # Maximum context window for conversations
auto_summarize = true                            # Enable automatic message summarization
summary_service_base_url = "http://localhost:10086/v1"  # Base URL for summary service
summary_service_api_key = ""                            # API key for summary service (leave empty if not required)

# Summarization strategies:
# - "Incremental": Use existing summary + new messages (default, more efficient)
# - "FullHistory": Re-summarize all historical messages (better context, more expensive)
summarization_strategy = "Incremental"

# Message summarization configuration:
# - When message count reaches 'max_stored_messages', summarization is triggered
# - After summarization, at least 'summarize_threshold/2' recent messages are kept
# - Relationship: max_stored_messages > summarize_threshold (recommended)
# - Example: 20 messages trigger → keep 6 recent → summarize 14 old messages
max_stored_messages = 20                         # Trigger summarization when message count reaches this limit
summarize_threshold = 12                         # Base number for calculating minimum kept messages (kept = threshold/2)


# ============================================================================
# SECTION 1.5: SKILLS CONFIGURATION
# ============================================================================
# Skills are modular capabilities that extend the AI's abilities.
# Each skill contains a SKILL.md file with metadata and optional scripts.

[skill]
enabled = true                              # Enable Skills system
directories = [                             # Directories to scan for Skills
    # "/path/to/custom/skills",   # Your custom skills directory
    ".skills",                              # Project-local skills
    "~/.aries/skills"                 # User-level skills
]

# Skills API configuration for authentication and rate limiting
# Controls access to Skills management API endpoints
[skill.api]
# api_key = "sk-your-secret-key"  # API key for Skills API (or set SKILLS_API_KEY env var)
# rate_limit_requests = 100       # Maximum requests per window (default: 100, 0 to disable)
# rate_limit_window_secs = 60     # Rate limit window in seconds (default: 60)

# Skills marketplace configuration (skillsmp.com)
# Use: aries skill install skillsmp:<name>
[skill.market]
# url = "https://skillsmp.com/api/v1"       # API URL (default)
# api_key = "your-api-key"                  # API key (or set SKILLSMP_API_KEY env var)
# cache_dir = "~/.aries/cache/skills" # Download cache directory (optional)

# Script execution configuration for Skills
[skill.execution]
enabled = true                              # Enable script execution

# Default resource limits for script execution
[skill.execution.limits]
max_memory_bytes = 268435456    # Maximum memory: 256MB (default)
timeout = "30s"                 # Maximum execution time (default: 30s)
max_output_bytes = 1048576      # Maximum output size: 1MB (default)
network_access = false          # Whether to allow network access (default: false)

# Deno executor configuration (for JavaScript/TypeScript)
# Supported extensions: js, ts, mjs, mts, jsx, tsx
[skill.execution.deno]
deno_path = "deno"              # Path to Deno binary (default: "deno" from PATH)
allow_net = false               # Allow network access by default
allow_env = false               # Allow environment variable access by default
allow_hrtime = false            # Allow high-resolution time measurement
unstable = false                # Run in unstable mode
cache = true                    # Cache compiled scripts
# cache_dir = "/tmp/deno-cache" # Custom cache directory (optional)
# v8_flags = []                 # Additional V8 flags (optional)

# Docker executor configuration (for Python, Shell, Ruby, etc.)
# Supported extensions: py, sh, bash, rb
# NOTE: Requires Docker daemon running. Enable this section to use Docker sandbox.
[skill.execution.docker]
# socket = "/var/run/docker.sock"  # Docker socket path (auto-detect if not set)
default_image = "alpine:latest"    # Default image for unknown script types
auto_remove = true                 # Auto-remove containers after execution
read_only = true                   # Use read-only root filesystem for security
network_mode = "none"              # Network mode: "none" for isolation (recommended)
container_prefix = "aries-exec"  # Container name prefix
auto_pull = true                   # Auto-pull images if not present locally

# File access strategy for data files referenced in script arguments
# - "auto": (Default) Try bind mount first, fall back to file copy if not in data_dirs
# - "bind_only": Only use bind mounts (fail if file not in data_dirs)
# - "copy_only": Always copy files to temp directory (best for remote/network scenarios)
file_access_mode = "auto"

# Additional directories to mount in container (read-write for output files)
# Format: "/host/path" or "/host/path:/container/path"
# Files in these directories can be accessed directly via absolute paths
data_dirs = [
    "~/aries/skills",  # Skills directory (for accessing example files)
    # "/path/to/data:/data",               # Custom data directory
]

# Temporary directory for file copy mode (optional, defaults to system temp)
# temp_dir = "/tmp/aries"

# Whether to copy output files back to original location after execution (default: true)
# Only applies when using file copy strategy
copy_output_back = true

# Image mapping for different script types (extension -> Docker image)
[skill.execution.docker.images]
py = "python:3.11-slim"            # Python scripts
sh = "alpine:latest"               # Shell scripts
bash = "alpine:latest"             # Bash scripts
rb = "ruby:3.2-slim"               # Ruby scripts
# js = "node:20-slim"              # Node.js (if needed, usually handled by Deno)


# ============================================================================
# SECTION 1.6: REFLECTION SYSTEM CONFIGURATION
# ============================================================================
# The reflection system provides self-correction capabilities.
# It evaluates subtask results using LLM-driven analysis and can trigger
# retries or replanning when issues are detected.

[reflection]
enabled = true                        # Enable reflection system
confidence_threshold = 0.7            # Confidence threshold (0.0-1.0) below which issues are flagged
max_reflection_rounds = 3             # Maximum reflection rounds per subtask
enable_result_validation = true       # Enable structural/semantic result validation
enable_path_optimization = false      # Enable path optimization suggestions (experimental)

# ============================================================================
# SECTION 1.7: DYNAMIC REPLANNING CONFIGURATION
# ============================================================================
# The dynamic replanning system automatically adjusts the plan when subtasks
# fail or external conditions change. It analyzes failure patterns and can
# insert recovery steps, reorder tasks, or trigger a full replan.

[replan]
enabled = true                        # Enable dynamic replanning
max_replan_attempts = 2               # Maximum number of replan attempts
critical_dependent_threshold = 2      # Threshold for considering a subtask critical (based on dependent count)
failure_rate_threshold = 0.5          # Failure rate threshold (0.0-1.0) for triggering replanning
min_time_per_subtask = 30             # Minimum time in seconds required per subtask


# ============================================================================
# SECTION 1.8: CONFIGURATION API SETTINGS
# ============================================================================
# The Configuration API provides runtime configuration management with
# support for hot-reload when the configuration file changes.

[config_api]
hot_reload_enabled = true            # Enable configuration file hot-reload
hot_reload_debounce_ms = 500          # Debounce delay for file change events (ms)
hot_reload_keep_on_invalid = true     # Keep current config when new config is invalid
hot_reload_audit = false              # Log all hot-reload changes for auditing


# ============================================================================
# SECTION 1.9: SUB-AGENT CONFIGURATION
# ============================================================================
# Sub-Agents are autonomous child agents spawned by the main agent to handle
# specific subtasks independently. They have their own execution context,
# tool access controls, and lifecycle management.
#
# Use cases:
# - Parallel task execution (e.g., searching multiple sources simultaneously)
# - Specialized tasks requiring different tool sets
# - Complex workflows with hierarchical task decomposition

[subagent]
enabled = false                       # Enable Sub-Agent functionality (default: false)

# Execution mode determines how Subtasks are executed:
# - "direct": Traditional mode - Subtasks executed directly via React loop (default)
# - "subagent": New mode - Subtasks delegated to Sub-Agents for autonomous execution
execution_mode = "direct"

max_nesting_depth = 2                 # Maximum nesting depth (0 = no nesting, 1 = main -> sub, etc.)
max_concurrent = 5                    # Maximum concurrent Sub-Agents
default_timeout_secs = 300            # Default timeout per Sub-Agent in seconds (5 minutes)
default_max_iterations = 10           # Maximum iterations per Sub-Agent
allow_full_tool_access = false        # Whether Sub-Agents can access all tools by default

# Tool access control
# - default_allowed_tools: Tools explicitly allowed for Sub-Agents (empty = allow all unless blocked)
# - default_blocked_tools: Tools explicitly blocked for Sub-Agents
# Note: blocked_tools takes precedence over allowed_tools
default_allowed_tools = []            # Empty means no explicit allow list (use blocked list instead)
default_blocked_tools = ["spawn_sub_agent"]  # Prevent infinite nesting by default

# Failure handling policy
# - "fail": Stop execution on first failure and propagate error to main Agent
# - "fail_fast": Immediately stop entire execution flow
# - "notify": Notify main Agent and let it decide how to handle
# - "retry": Automatically retry failed Sub-Agents (up to retry_attempts times)
# - "ignore" / "skip": Ignore failures and continue execution
# - "retry_then_skip": Retry first, then skip if still failing
# - "retry_then_fail": Retry first, then fail if still failing
failure_policy = "notify"
retry_attempts = 2                    # Retry count when using "Retry" policy

# Total token limit across all Sub-Agents (0 = unlimited)
max_total_tokens = 0

# Sub-Agent reflection (self-correction) configuration
[subagent.reflection]
enabled = false                       # Enable reflection for Sub-Agents
confidence_threshold = 0.7            # Minimum confidence to accept result (0.0-1.0)
max_retries = 2                       # Maximum reflection retries
reflect_on_tool_error = true          # Trigger reflection when a tool call fails
reflect_interval = 5                  # Reflect every N iterations (0 = disabled)
reflect_on_completion = true          # Reflect when Sub-Agent completes

# Subtask Executor configuration (effective when execution_mode = "subagent")
# Controls how Sub-Agents execute Subtasks
[subagent.subtask_executor]
# Parallel execution mode:
# - "auto": Automatically determine parallel groups based on dependencies (default)
# - "sequential": Execute all subtasks sequentially
# - "manual": Use explicit parallel groups (requires plan annotations)
parallel_mode = "auto"
max_parallel = 3                      # Maximum number of parallel Sub-Agents

# Tool inheritance from parent
inherit_tools = true                  # Inherit tools from main Agent
inherit_skills = true                 # Inherit skills from main Agent
blocked_tools = ["spawn_sub_agent"]   # Tools blocked for Subtask execution

# Spawn configuration
allow_nested_spawn = false            # Whether Sub-Agents can spawn child Sub-Agents

# Timeout configuration
timeout_secs = 120                    # Timeout per Subtask in seconds
inherit_remaining_time = true         # Inherit remaining time from parent timeout
grace_period_secs = 10                # Grace period for graceful shutdown

# Retry configuration (for "subagent" mode)
# - "internal": Sub-Agent handles retries internally
# - "respawn": Respawn a new Sub-Agent for retry (injects failure context)
retry_mode = "respawn"
max_retries = 2                       # Maximum retries per Subtask
retry_delay_ms = 1000                 # Delay between retries in milliseconds
inject_failure_context = true         # Inject previous failure info on retry

# Context passing configuration
# Controls how context is shared between main Agent and Sub-Agents
[subagent.context]
# Context mode:
# - "inject": Inject relevant context into Sub-Agent's initial prompt (default)
# - "shared": Use shared memory/artifact storage
# - "hybrid": Combine inject and shared modes
mode = "inject"
max_inject_tokens = 2000              # Maximum tokens to inject into Sub-Agent context
use_summary = true                    # Summarize context if exceeding max_inject_tokens
artifact_storage = false              # Enable artifact storage for context sharing

# API rate limiting configuration
# Prevents overwhelming the LLM API with concurrent requests
[subagent.rate_limit]
requests_per_minute = 60              # Maximum API requests per minute
tokens_per_minute = 100000            # Maximum tokens per minute (0 = unlimited)
retry_max_attempts = 3                # Maximum retry attempts when rate limited
retry_base_delay_ms = 1000            # Base delay for exponential backoff (ms)


# ============================================================================
# SECTION 1.10: HITL (HUMAN-IN-THE-LOOP) CONFIGURATION
# ============================================================================
# The HITL system provides human oversight for AI tool operations.
# It uses a three-layer risk assessment mechanism:
#   L1: Developer declaration (tool_overrides) - explicit risk configuration
#   L2: System inference - automatic risk detection based on tool semantics
#   L3: Runtime learning - adjust risk based on user approval history
#
# Risk levels: low, medium, high, critical
#   - Operations at or above 'confirmation_threshold' require human approval
#   - 'safe' level is only achievable through L3 runtime learning
#
# Timeout behaviors: reject, approve, skip, abort, wait
#   - reject: Reject the operation (default)
#   - approve: Auto-approve (only for low risk, forced to reject for high/critical)
#   - skip: Skip this operation and continue
#   - abort: Abort the entire task
#   - wait: Wait indefinitely (no timeout)

[hitl]
enabled = true                       # Enable HITL system (default: true when section present)
default_timeout_secs = 300            # Default timeout in seconds (5 minutes)
default_timeout_behavior = "wait"     # Default behavior: wait indefinitely for user response
confirmation_threshold = "low"     # Minimum risk level that requires confirmation

# L1: Developer-declared tool risk overrides
# Use this to explicitly set risk levels for specific tools
# Note: 'safe' level cannot be declared here (only achievable through L3 learning)
#
# Example:
# [hitl.tool_overrides.dangerous_command]
# risk_level = "critical"             # low, medium, high, critical
# timeout_secs = 600                  # Optional: override timeout for this tool
# timeout_behavior = "reject"         # Optional: override timeout behavior
#
# [hitl.tool_overrides.file_write]
# risk_level = "high"
# timeout_secs = 120

# L3: Runtime learning configuration (optional)
# When enabled, the system learns from user approval patterns and can
# automatically reduce risk levels for frequently approved operations.
#
# [hitl.runtime_learning]
# approvals_per_level = 3             # Consecutive approvals needed to reduce one risk level
# trust_duration_secs = 604800        # Trust validity period in seconds (7 days, 0 = permanent)
# min_level = "low"                   # Minimum level that can be reached through learning


# ============================================================================
# SECTION 1.11: SESSION HISTORY CONFIGURATION
# ============================================================================
# The session system provides JSONL-based chat history persistence for
# normal (non-privacy) sessions. Each session is stored as a JSONL file
# organized by user ID.
#
# Storage layout: {storage_path}/{user_id}/{session_id}.jsonl

[session]
enable = true                         # Enable session history recording (default: true)
storage_path = "~/.aries/sessions"     # Directory for storing session JSONL files
                                      # Supports ~ for home directory expansion


# ============================================================================
# SECTION 1.12: SMART PRIVACY DETECTION CONFIGURATION
# ============================================================================
# The smart privacy detection system automatically detects privacy-sensitive
# content in user queries and prompts users to confirm whether to use privacy
# mode. This replaces the manual "New Chat In Privacy" button with intelligent
# detection.
#
# Detection modes:
#   - "rules_only": Use only rule-based detection (keywords + regex patterns)
#   - "rules_then_model": Rules first, model fallback if rules uncertain (default)
#   - "model_only": Use only LLM-based detection
#   - "combined": Use both rules and model, merge results
#
# When privacy content is detected, a HITL confirmation request is sent to the
# user. Users can choose to:
#   - Use privacy mode (routes to privacy_chat service)
#   - Continue with normal mode (routes to chat service)
#   - Remember choice for the session

[privacy_detection]
enabled = true                        # Enable smart privacy detection (default: true)
mode = "rules_then_model"             # Detection mode (default: rules_then_model)
rule_confidence_threshold = 0.6       # Minimum confidence for rule-based detection (0.0-1.0)
model_confidence_threshold = 0.8      # Minimum confidence for model-based detection (0.0-1.0)
min_text_length = 5                   # Skip detection for very short texts (default: 5 chars)

# Custom keywords to detect as privacy-sensitive (in addition to built-in keywords)
custom_keywords = ["机密", "internal only", "confidential"]


# ============================================================================
# SECTION 2: AI SERVICE CONFIGURATION
# ============================================================================
# This section contains configuration for AI services including chat and
# embedding models. These are optional services that can be enabled as needed.

# [chat]
# url = "https://api.openai.com/v1"  # Base URL for the model API
# api_key = ""                       # API key for the model service (leave empty to use environment variable: DEFAULT_CHAT_SERVICE_API_KEY)

# [embedding]
# url = "https://api.openai.com/v1"  # Base URL for the model API
# api_key = ""                       # API key for the model service (leave empty to use environment variable: DEFAULT_EMBEDDING_SERVICE_API_KEY)


# ============================================================================
# SECTION 3: MCP TOOL SERVER CONFIGURATION
# ============================================================================
# This section contains configuration for Model Context Protocol (MCP) tool
# servers. These provide additional capabilities and integrations.
#
# Note: If any MCP tool servers are enabled, ensure the corresponding MCP
# server is started before starting the Aries server.

# Section 3.1: Third Party MCP Servers
#
# The following items are the configuration for the third party MCP tool servers:
#
# - name: The name of the MCP tool server.
# - transport: The transport protocol to use. Possible values: "sse", "stream-http", and "stdio".
# - url: The URL of the MCP tool server. ONLY one of `url` and `oauth_url` should be set. (For "sse" and "stream-http" only)
# - oauth_url: The URL of the MCP tool server for OAuth authentication. ONLY one of `url` and `oauth_url` should be set. (For "sse" and "stream-http" only)
# - command: The command to run for stdio transport. (For "stdio" only)
# - args: Arguments for the stdio command. (For "stdio" only)
# - env: Environment variables for the stdio process. (For "stdio" only)
# - working_dir: Working directory for the stdio process. (For "stdio" only)
# - enable: Whether to enable the MCP tool server.
#
# For stdio transport, additional configuration can be set under the `stdio` section:
# - health_check_interval_secs: Interval for health checks (default: 30, set to 0 to disable)
# - health_check_timeout_secs: Timeout for each health check (default: 5)
# - health_check_failure_threshold: Number of consecutive failures before marking as failed (default: 3)
# - restart_on_failure: Whether to automatically restart on failure (default: true)
# - max_restart_attempts: Maximum restart attempts before giving up (default: 3)
# - restart_backoff_secs: Delay between restart attempts (default: 5)

# The following config is for an example stdio MCP server (actionbook).
# Stdio transport starts the MCP server as a child process and communicates via stdin/stdout.
# The process is started lazily on the first tool call, not at system startup.
#
# WARNING: stdio processes run with Aries Agent privileges. Only use trusted MCP servers.
# [[mcp.server.tool]]
# name    = "actionbook"
# transport = "stdio"
# command = "npx"
# args    = ["-y", "@anthropic-ai/claude-code-mcp@latest"]
# enable  = false
# stdio.health_check_interval_secs = 60
# stdio.restart_on_failure = true
# stdio.max_restart_attempts = 5

# The following config is for the markitdown mcp server.
# The details about the server are available at https://github.com/microsoft/markitdown/tree/main/packages/markitdown-mcp
[[mcp.server.tool]]
name      = "markitdown"
transport = "stream-http"
url       = "http://127.0.0.1:8011/mcp"
enable    = false

# The following config is for the zapier-mcp server (Connect URL mode).
# The details about the server are available at https://mcp.zapier.com/mcp/servers
# To get your Connect URL and token, visit: https://mcp.zapier.com
[[mcp.server.tool]]
name          = "zapier-mcp"
transport     = "stream-http"
url           = "https://mcp.zapier.com/api/v1/connect"
api_key_param = "token"
api_key       = ""
enable        = false

# The following config is for the AMap Maps mcp server.
# The details about the server are available at https://lbs.amap.com/api/mcp-server/summary
[[mcp.server.tool]]
name          = "amap-maps"
transport     = "stream-http"
url           = "https://mcp.amap.com/mcp"
api_key_param = "key"
api_key       = ""
enable        = false

# The following config is for the Tavily mcp server
# The details about the server are available at https://github.com/tavily-ai/tavily-mcp
# Note: api_key is stored separately and dynamically appended to the URL as the
# query parameter specified by api_key_param. You can manage it via the MCP management page.
[[mcp.server.tool]]
name          = "tavily"
transport     = "stream-http"
url           = "https://mcp.tavily.com/mcp"
api_key_param = "tavilyApiKey"
api_key       = ""
enable        = false


# Section 3.2: Cardea MCP Servers
#
# The following items are the configuration for the MCP tool servers:
#
# - name: The name of the MCP tool server.
# - transport: The transport protocol to use. Possible values: "sse" and "stream-http".
# - url: The URL of the MCP tool server.
# - enable: Whether to enable the MCP tool server.
# - fallback_message (Optional): The fallback message to use if the MCP tool server returns an empty response.


# # The following config is for the cardea-agentic-search mcp server.
# # The details about the server are available at https://github.com/cardea-mcp/gaia-mcp-servers/tree/main/cardea-agentic-search
# [[mcp.server.tool]]
# name             = "cardea-agentic-search"
# transport        = "stream-http"
# url              = "http://127.0.0.1:8009/mcp"
# enable           = false
# fallback_message = "Hmm, I couldn’t find enough info to answer that one just yet. Want to try asking in a different way?"

# # The following config is for the cardea-web-search mcp server.
# # The details about the server are available at https://github.com/cardea-mcp/gaia-mcp-servers/tree/main/cardea-web-search
# [[mcp.server.tool]]
# name      = "cardea-web-search"
# transport = "stream-http"
# url       = "http://127.0.0.1:8010/mcp"
# enable    = false

# The following config is for the cardea-calculator mcp server.
# The details about the server are available at https://github.com/cardea-mcp/gaia-mcp-servers/tree/main/cardea-calculator
[[mcp.server.tool]]
name      = "cardea-calculator"
transport = "stream-http"
url       = "http://127.0.0.1:8001/mcp"
enable    = false

# The following config is for the cardea-weather mcp server.
# The details about the server are available at https://github.com/cardea-mcp/gaia-mcp-servers/tree/main/cardea-weather
[[mcp.server.tool]]
name      = "cardea-weather"
transport = "stream-http"
url       = "http://127.0.0.1:8002/mcp"
enable    = false

# # The following config is for the cardea-qdrant mcp server.
# # The details about the server are available at https://github.com/cardea-mcp/gaia-mcp-servers/tree/main/cardea-qdrant
# [[mcp.server.tool]]
# name      = "cardea-qdrant"
# transport = "stream-http"
# url       = "http://127.0.0.1:8003/mcp"
# enable    = false

# # Section 3.3: Keyword Search MCP Servers
# #
# # The following items are the keyword search mcp server configurations:
# #
# # - name: The name of the mcp server.
# # - transport: The transport protocol to use. Possible values: "sse" and "stream-http".
# # - url: The URL of the mcp server.
# # - enable: Whether to enable the mcp server.
# #
# # If you want to use keyword search in the retrieval phase, please enable ONLY one of the following
# # three keyword search mcp servers.

# # The following config is for the cardea-keyword-search mcp server.
# # The details about the server are available at https://github.com/cardea-mcp/gaia-mcp-servers/tree/main/cardea-kwsearch
# [[mcp.server.tool]]
# name      = "cardea-keyword-search"
# transport = "stream-http"
# url       = "http://127.0.0.1:8005/mcp"
# enable    = false

# # The following config is for the cardea-elastic-search mcp server.
# # The details about the server are available at https://github.com/cardea-mcp/gaia-mcp-servers/tree/main/cardea-elastic
# [[mcp.server.tool]]
# name      = "cardea-elastic-search"
# transport = "stream-http"
# url       = "http://127.0.0.1:8006/mcp"
# enable    = false

# # The following config is for the cardea-tidb-search mcp server.
# # The details about the server are available at https://github.com/cardea-m
# [[mcp.server.tool]]
# name      = "cardea-tidb-search"
# transport = "stream-http"
# url       = "http://127.0.0.1:8007/mcp"
# enable    = false
