# Lantai Configuration
# Place this file at ~/.lantai/config.toml (global) or .lantai.toml (project-level)
#
# Configuration priority (higher overrides lower):
#   1. Default values (built-in)
#   2. Global config: ~/.lantai/config.toml
#   3. Project config: .lantai.toml (current directory)
#   4. Environment variables: LANTAI_MEMORY_DIR, LANTAI_DATABASE_PATH,
#      LANTAI_EMBEDDING_MODEL, LANTAI_EMBEDDING_DIMENSIONS

# Memory files directory
memory_dir = "~/.lantai/memory"

# SQLite database path
database_path = "~/.lantai/lantai.db"

[chunking]
max_chunk_lines = 50
min_chunk_lines = 5

[embedding]
model = "text-embedding-3-small"
dimensions = 1536
batch_size = 32

[search]
default_limit = 5
vec_weight = 0.6
bm25_weight = 0.4
rrf_k = 60

[watch]
debounce_ms = 1500
